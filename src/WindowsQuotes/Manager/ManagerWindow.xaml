<Window x:Class="WindowsQuotes.Manager.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Quotes"
        Width="760"
        Height="640"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <TabControl x:Name="Tabs" Margin="12" SelectionChanged="OnTabChanged">

        <TabItem Header="My Quotes" x:Name="QuotesTab">
            <Grid Margin="4,12,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" ToolTip="Search your quotes" />
                <TextBlock Text="Search your quotes"
                           IsHitTestVisible="False"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Opacity="0.55">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid Grid.Row="1" Margin="0,10,0,10">
                    <ListBox x:Name="QuoteList"
                             SelectionChanged="OnQuoteSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Author}" Opacity="0.65" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyMessage"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.65"
                               IsHitTestVisible="False"
                               TextAlignment="Center"
                               Text="No quotes yet. Add your first one below." />
                </Grid>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Quote" Margin="0,0,0,4" />
                    <TextBox x:Name="QuoteInput"
                             AcceptsReturn="False"
                             TextWrapping="Wrap"
                             MinHeight="72"
                             MaxHeight="120"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="OnEditorChanged" />
                    <TextBlock Text="Author (optional)" Margin="0,10,0,4" />
                    <TextBox x:Name="AuthorInput" TextChanged="OnEditorChanged" />
                    <TextBlock x:Name="EditorMessage" Margin="0,8,0,0" Opacity="0.75" MinHeight="18" />
                    <DockPanel Margin="0,8,0,0" LastChildFill="False">
                        <Button x:Name="SaveButton" Content="Add quote" Click="OnSaveQuote" Style="{DynamicResource AccentButtonStyle}" />
                        <Button x:Name="ClearButton" Content="Clear" Click="OnClearEditor" Margin="8,0,0,0" />
                        <Button x:Name="DeleteButton" Content="Delete" Click="OnDeleteQuote" DockPanel.Dock="Right" Margin="8,0,0,0" />
                        <Button x:Name="PinButton" Content="Show and hold&#x2026;" Click="OnPinQuote" DockPanel.Dock="Right" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Settings" x:Name="SettingsTab">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,12,12,4" MaxWidth="560" HorizontalAlignment="Left" Width="520">
                    <TextBlock Text="Look" Margin="0,0,0,4" />
                    <ComboBox x:Name="LookBox" SelectionChanged="OnSettingChanged" />

                    <TextBlock Text="Controls" Margin="0,16,0,4" />
                    <ComboBox x:Name="ControlsBox" SelectionChanged="OnSettingChanged" />

                    <TextBlock Text="Change the quote every" Margin="0,16,0,4" />
                    <ComboBox x:Name="IntervalBox" SelectionChanged="OnSettingChanged" />

                    <TextBlock x:Name="OwnShareLabel" Margin="0,16,0,4" />
                    <Slider x:Name="OwnShareSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />

                    <TextBlock x:Name="TextScaleLabel" Margin="0,16,0,4" />
                    <Slider x:Name="TextScaleSlider" Minimum="70" Maximum="160" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />

                    <TextBlock Text="Monitor" Margin="0,16,0,4" />
                    <ComboBox x:Name="MonitorBox" SelectionChanged="OnSettingChanged" />

                    <Button x:Name="ResetPositionButton" Content="Reset widget position" Click="OnResetPosition" Margin="0,12,0,0" HorizontalAlignment="Left" />

                    <CheckBox x:Name="StartupBox" Content="Start with Windows" Margin="0,18,0,0" Click="OnStartupClicked" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Sources" x:Name="SourcesTab">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,12,12,4">
                    <StackPanel x:Name="SourceList" />
                    <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Opacity="0.75"
                               Text="Quotes are saved after each fetch, so the widget keeps working offline. Online quotes come as they are, and their attributions aren't always accurate." />
                    <TextBlock Margin="0,14,0,0">
                        <Run Text="Inspirational quotes provided by" />
                        <Hyperlink NavigateUri="https://zenquotes.io/" RequestNavigate="OnOpenLink">ZenQuotes API</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
