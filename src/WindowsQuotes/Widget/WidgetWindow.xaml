<Window x:Class="WindowsQuotes.Widget.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quote"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent">
    <Border x:Name="Root" Padding="28,24">
        <StackPanel>
            <TextBlock x:Name="QuoteText"
                       FontFamily="Sitka Display, Georgia"
                       FontSize="28"
                       Foreground="White"
                       TextWrapping="Wrap"
                       TextOptions.TextFormattingMode="Ideal"
                       Text="We need never be ashamed of our tears.">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.65" Color="Black" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="AuthorText"
                       Margin="0,12,0,0"
                       FontFamily="Sitka Text, Georgia"
                       FontSize="15"
                       Foreground="#E6FFFFFF"
                       Text="Charles Dickens">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.65" Color="Black" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
